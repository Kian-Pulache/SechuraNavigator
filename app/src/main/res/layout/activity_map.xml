<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <!-- Mapa principal -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de datos inferior -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC060E1C"
        android:padding="6dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— kt"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—°S  —°W"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— m"
            android:textColor="#10B981"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Botón volver -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:background="#CC060E1C"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="10dp" />

    <!-- Contenedor del buscador + lista de resultados -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC060E1C"
            android:textColor="#FFFFFF"
            android:textColorHint="#4B5563"
            android:hint="🔍 Buscar waypoint..."
            android:textSize="12sp"
            android:padding="10dp"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <!-- Lista de sugerencias — oculta por defecto -->
        <ListView
            android:id="@+id/listSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:background="#EE060E1C"
            android:divider="#1F2937"
            android:dividerHeight="0.5dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Toggle capas -->
    <LinearLayout
        android:id="@+id/layersBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC060E1C"
        android:padding="6dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="10dp">

        <TextView
            android:id="@+id/toggleConcesiones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concesiones"
            android:textSize="10sp"
            android:textColor="#6EE7B7"
            android:background="#1A10B981"
            android:padding="5dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/toggleBoyas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boyas"
            android:textSize="10sp"
            android:textColor="#6B7280"
            android:background="#0D1F3C"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Leyenda -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC060E1C"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Concha"
            android:textColor="#F59E0B"
            android:textSize="9sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Pulpo"
            android:textColor="#60A5FA"
            android:textSize="9sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Langosta"
            android:textColor="#A78BFA"
            android:textSize="9sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Pescado"
            android:textColor="#10B981"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Botón zoom + -->
    <TextView
        android:id="@+id/btnZoomIn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#CC0D1F3C"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnZoomOut"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp" />

    <!-- Botón zoom - -->
    <TextView
        android:id="@+id/btnZoomOut"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="−"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#CC0D1F3C"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="48dp" />

    <!-- Botón BOY (boya instantánea) -->
    <TextView
        android:id="@+id/btnBoya"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="BOY"
        android:textColor="#0A1628"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#60A5FA"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Mini-menú flotante (oculto por defecto) -->
    <LinearLayout
        android:id="@+id/miniMenu"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0060E1C"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/miniMenuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Punto"
            android:textColor="#FBBF24"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/miniMenuNavigate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Ir al punto"
            android:textColor="#0A1628"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#F59E0B"
            android:padding="6dp"
            android:gravity="center"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/miniMenuEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✎ Editar"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:background="#0D1F3C"
            android:padding="6dp"
            android:gravity="center"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/miniMenuDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✕ Eliminar"
            android:textColor="#FCA5A5"
            android:textSize="11sp"
            android:background="#1AEF4444"
            android:padding="6dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Botón de grabación de track -->
    <TextView
        android:id="@+id/btnRecord"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="⏺"
        android:textColor="#0A1628"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#EF4444"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBoya"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="6dp" />

    <!-- Escala gráfica dinámica -->
    <com.sechuranavigator.app.ui.MapScaleView
        android:id="@+id/mapScale"
        android:layout_width="160dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>