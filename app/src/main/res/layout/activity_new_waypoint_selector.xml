<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#060E1C"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Cancelar"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nuevo waypoint"
            android:textColor="#FBBF24"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="     " />

    </LinearLayout>

    <!-- Indicador de precisión GPS actual -->
    <LinearLayout
        android:id="@+id/cardGpsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1F3C"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvGpsStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGpsAccuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscando señal GPS..."
                android:textColor="#6B7280"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvGpsCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4B5563"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F2937" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Pregunta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Cómo deseas guardar el punto?"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- OPCIÓN 1: Ubicación actual (destacada en ámbar) -->
        <LinearLayout
            android:id="@+id/optionCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1AF59E0B"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="📡"
                android:textSize="22sp"
                android:gravity="center"
                android:background="#2AF59E0B"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar ubicación actual"
                    android:textColor="#FBBF24"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usa tu posición GPS en este momento"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <!-- Badge de precisión — se actualiza con el GPS -->
                <TextView
                    android:id="@+id/tvAccuracyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esperando GPS..."
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    android:background="#0D1F3C"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#F59E0B"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- OPCIÓN 2: Marcar en el mapa -->
        <LinearLayout
            android:id="@+id/optionMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0D1F3C"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🗺"
                android:textSize="22sp"
                android:gravity="center"
                android:background="#141E3A5F"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marcar en el mapa"
                    android:textColor="#E5E7EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca el mapa para elegir un punto exacto"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#374151"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- OPCIÓN 3: Ingresar coordenadas manualmente -->
        <LinearLayout
            android:id="@+id/optionManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0D1F3C"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⌨"
                android:textSize="22sp"
                android:gravity="center"
                android:background="#141E3A5F"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresar coordenadas"
                    android:textColor="#E5E7EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escribe latitud y longitud manualmente"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#374151"
                android:textSize="22sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>