<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#060E1C"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalle del punto"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Botón guardar cambios (visible solo al editar) -->
            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Card de coordenadas y precisión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D1F3C"
            android:padding="14dp"
            android:layout_margin="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvSpeciesIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:text="📍"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCoordLat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FBBF24"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoordLon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FBBF24"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Favorito -->
                <TextView
                    android:id="@+id/btnFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="☆"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Stats en fila -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="precisión"
                        android:textColor="#6B7280"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvSatellites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60A5FA"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="satélites"
                        android:textColor="#6B7280"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvVisitCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A78BFA"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="visitas"
                        android:textColor="#6B7280"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvAltitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FB923C"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="altitud"
                        android:textColor="#6B7280"
                        android:textSize="9sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Sección editable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Nombre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOMBRE"
                android:textColor="#4B5563"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0D1F3C"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:hint="Sin nombre"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginBottom="14dp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <!-- Especie -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESPECIE"
                android:textColor="#4B5563"
                android:textSize="9sp"
                android:layout_marginBottom="8dp" />

            <!-- Chips de especie — fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/chipConcha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐚 Concha"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipPulpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐙 Pulpo"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipPescado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐟 Pescado"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Chips de especie — fila 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/chipLangosta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🦞 Langosta"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipCaracol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐌 Caracol"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipOtro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+ Otro"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="#0D1F3C"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMENTARIOS"
                android:textColor="#4B5563"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0D1F3C"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:hint="Profundidad, condiciones, notas..."
                android:textSize="13sp"
                android:padding="12dp"
                android:layout_marginBottom="14dp"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top" />

            <!-- Fecha de creación (solo lectura) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREADO"
                android:textColor="#4B5563"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCreatedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0D1F3C"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="🧭 Navegar"
                android:textColor="#0A1628"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:background="#F59E0B"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑 Borrar"
                android:textColor="#FCA5A5"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="14dp"
                android:background="#1AEF4444"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Espaciado final -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>