<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:gravity="center"
    android:padding="24dp">

    <!-- Logo / Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐚 Sechura Navigator"
        android:textColor="#FBBF24"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Navegación para pescadores artesanales"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:layout_marginBottom="40dp"/>

    <!-- Tabs Login / Registro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tabLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iniciar sesión"
            android:textColor="#FBBF24"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:background="#1AF59E0B"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tabRegister"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Registrarse"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="10dp"
            android:background="#0D1F3C"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Campo nombre (solo en registro) -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1F3C"
        android:textColor="#FFFFFF"
        android:textColorHint="#4B5563"
        android:hint="Nombre completo"
        android:textSize="13sp"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:inputType="textPersonName|textCapWords"
        android:visibility="gone"/>

    <!-- Campo email -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1F3C"
        android:textColor="#FFFFFF"
        android:textColorHint="#4B5563"
        android:hint="Correo electrónico"
        android:textSize="13sp"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:inputType="textEmailAddress"/>

    <!-- Campo contraseña -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1F3C"
        android:textColor="#FFFFFF"
        android:textColorHint="#4B5563"
        android:hint="Contraseña (mínimo 6 caracteres)"
        android:textSize="13sp"
        android:padding="14dp"
        android:layout_marginBottom="20dp"
        android:inputType="textPassword"/>

    <!-- Enlace olvidé contraseña — visible solo en modo login -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Olvidaste tu contraseña?"
        android:textColor="#60A5FA"
        android:textSize="11sp"
        android:gravity="end"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Botón principal -->
    <TextView
        android:id="@+id/btnAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textColor="#0A1628"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="#F59E0B"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <!-- Continuar sin cuenta -->
    <TextView
        android:id="@+id/btnSkipAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continuar sin cuenta (solo local)"
        android:textColor="#4B5563"
        android:textSize="11sp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>