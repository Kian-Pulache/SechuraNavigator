<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#060E1C"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis puntos"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="     "
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Buscador -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1F3C"
        android:textColor="#FFFFFF"
        android:textColorHint="#4B5563"
        android:hint="🔍  Buscar por nombre o especie..."
        android:textSize="13sp"
        android:padding="14dp"
        android:inputType="text"
        android:maxLines="1" />

    <!-- Lista de waypoints -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerWaypoints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No hay waypoints guardados.\nToca 'Nuevo punto' para agregar uno."
        android:textColor="#4B5563"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>