<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <!-- Logo centrado -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:src="@drawable/splash_logo"
        android:scaleType="fitCenter"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

<!-- Texto animado debajo del logo -->
    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Orgullosos de ser pescadores"
        android:textColor="#F59E0B"
        android:textSize="15sp"
        android:letterSpacing="0.08"
        android:alpha="0"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/splashLogo"
        app:layout_constraintBottom_toTopOf="@id/splashVersion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Versión abajo del todo -->
    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 · Sechura, Piura"
        android:textColor="#374151"
        android:textSize="10sp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>