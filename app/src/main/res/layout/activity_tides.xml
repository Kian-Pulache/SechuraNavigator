<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#060E1C"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mareas · Sechura"
                android:textColor="#60A5FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4B5563"
                android:textSize="9sp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Fecha y navegación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#060E1C"
            android:padding="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- Grid de datos principales -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:padding="1dp"
            android:background="#1F2937">

            <com.sechuranavigator.app.ui.DataCell
                android:id="@+id/cellCoefficient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="1dp" />

            <com.sechuranavigator.app.ui.DataCell
                android:id="@+id/cellTideType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="1dp" />

            <com.sechuranavigator.app.ui.DataCell
                android:id="@+id/cellMoon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="1dp" />

            <com.sechuranavigator.app.ui.DataCell
                android:id="@+id/cellCurrentStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="1dp" />

        </GridLayout>

        <!-- Gráfica de curva de marea -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CURVA DE MAREA — PRÓXIMAS 24 HORAS"
            android:textColor="#4B5563"
            android:textSize="9sp"
            android:padding="10dp"
            android:background="#060E1C" />

        <com.sechuranavigator.app.ui.TideChartView
            android:id="@+id/tideChart"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#060E1C" />

        <!-- Tabla de extremos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLEAMARES Y BAJAMARES · PRÓXIMOS 3 DÍAS"
            android:textColor="#4B5563"
            android:textSize="9sp"
            android:padding="10dp"
            android:background="#060E1C"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/containerExtremes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#060E1C"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>