<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D1F3C"
        android:padding="20dp">

        <!-- Cabecera con nombre del punto y stats de la visita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Visita registrada"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvWaypointName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9CA3AF"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Stats: llegada, permanencia, salida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvArrivalTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Llegada" android:textColor="#6B7280" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvDuration"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#10B981" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Permanencia" android:textColor="#6B7280" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvDepartureTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Salida" android:textColor="#6B7280" android:textSize="10sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ══ SECCIÓN 1: ¿Cuánto pescaste? ══ -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="¿CUÁNTO PESCASTE?"
            android:textColor="#4B5563" android:textSize="9sp" android:layout_marginBottom="8dp"/>

        <!-- Campo de producción — texto libre -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginBottom="6dp">

            <android.widget.EditText
                android:id="@+id/etCatchQuantity"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#0A1628"
                android:textColor="#FFFFFF" android:textColorHint="#4B5563"
                android:hint="ej: 20 valdes / 5 cajas / 8 pulpos / 20 kg"
                android:textSize="12sp" android:padding="12dp"
                android:inputType="textCapSentences"/>

        </LinearLayout>

        <!-- Personas en la faena -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginBottom="18dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¿Cuántas personas fueron?"
                android:textColor="#9CA3AF" android:textSize="12sp"/>

            <android.widget.EditText
                android:id="@+id/etNumPersons"
                android:layout_width="60dp" android:layout_height="wrap_content"
                android:background="#0A1628" android:textColor="#FFFFFF"
                android:hint="1" android:textSize="13sp" android:padding="10dp"
                android:inputType="number" android:gravity="center"/>

        </LinearLayout>

        <!-- ══ SECCIÓN 2: Condición del agua ══ -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="¿CÓMO ESTÁ EL AGUA HOY EN ESTE PUNTO?"
            android:textColor="#4B5563" android:textSize="9sp" android:layout_marginBottom="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Toca los que aplican (puedes elegir varios)"
            android:textColor="#374151" android:textSize="10sp" android:layout_marginBottom="10dp"/>

        <!-- Fila de tags — todos en una sola sección sin categorías -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/tagNormal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="normal"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagCorrientuda"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="agua corrientuda"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagTurbia"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="agua turbia"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagAmarillenta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="amarillenta (poco visible)"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagMovida"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="agua movida"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagViento"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="viento fuerte"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tagNs"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="no sé / sin observación"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

        </com.google.android.material.chip.ChipGroup>

        <!-- Notas adicionales opcionales -->
        <android.widget.EditText
            android:id="@+id/etCatchNotes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#0A1628" android:textColor="#FFFFFF"
            android:textColorHint="#4B5563"
            android:hint="Observaciones adicionales (opcional)..."
            android:textSize="12sp" android:padding="10dp"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" android:maxLines="3" android:gravity="top"
            android:layout_marginBottom="18dp"/>

        <!-- Botones -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">

            <TextView android:id="@+id/btnSkip"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Omitir"
                android:textColor="#6B7280" android:textSize="12sp"
                android:gravity="center" android:padding="14dp"
                android:background="#0A1628" android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnSaveProduction"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2" android:text="Guardar"
                android:textColor="#0A1628" android:textSize="12sp"
                android:textStyle="bold" android:gravity="center"
                android:padding="14dp" android:background="#10B981"
                android:clickable="true" android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>